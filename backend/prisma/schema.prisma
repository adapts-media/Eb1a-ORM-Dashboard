// Prisma schema for the ORM Dashboard.
// Default datasource is SQLite for zero-config local setup.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Platform Keyword card registered for manual & automated hourly scraping.
model PlatformKeyword {
  id          String    @id @default(cuid())
  platform    String    // "reddit" | "quora" | "teamblind" | "trustpilot"
  keyword     String
  searchUrl   String?
  enabled     Boolean   @default(true)
  lastRunAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Deletion safety net: a delete sets these instead of removing the row;
  // a restore within the window clears them; a purge sweep hard-deletes
  // once purgeAt has passed.
  deletedAt   DateTime?
  purgeAt     DateTime?

  @@unique([platform, keyword])
}

// Competitor Card registered for competitor analysis.
model CompetitorCard {
  id          String    @id @default(cuid())
  platform    String    // "reddit" | "quora" | "teamblind" | "trustpilot" | "all"
  keyword     String
  searchUrl   String?
  enabled     Boolean   @default(true)
  lastRunAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Opt-in switch for real AI sentiment analysis on this competitor's
  // mentions. Off by default: items are stored with a stamped NEUTRAL
  // placeholder and zero AI spend until a card explicitly opts in.
  sentimentEnabled Boolean @default(false)

  deletedAt   DateTime?
  purgeAt     DateTime?

  @@unique([platform, keyword])
}

// Groups spelling variants of the same brand/entity ("EB1A Experts",
// "EB-1A Experts", "eb1aexperts.com", ...) into one profile so the dashboard
// can show a single merged card with the per-variant breakdown underneath,
// instead of one card per spelling. Deliberately explicit/seeded, not
// fuzzy-matched, so an unrelated future keyword never gets folded in.
model KeywordGroup {
  id        String    @id @default(cuid())
  name      String    @unique
  createdAt DateTime  @default(now())

  keywords  Keyword[]
}

model Keyword {
  id        String   @id @default(cuid())
  term      String   @unique
  createdAt DateTime @default(now())

  groupId   String?
  group     KeywordGroup? @relation(fields: [groupId], references: [id])

  deletedAt DateTime?
  purgeAt   DateTime?

  scrapeRuns ScrapeRun[]
  posts      Post[]
  comments   Comment[]

  @@index([groupId])
}

model ScrapeRun {
  id          String   @id @default(cuid())
  keywordId   String
  keyword     Keyword  @relation(fields: [keywordId], references: [id])

  status      String   @default("RECEIVED")
  rawResponse String
  itemCount   Int      @default(0)
  errorMessage String?

  startedAt   DateTime @default(now())
  completedAt DateTime?

  posts    Post[]
  comments Comment[]

  @@index([keywordId])
}

model Post {
  id            String   @id @default(cuid())
  sourceKey     String   @unique

  keywordId     String
  keyword       Keyword  @relation(fields: [keywordId], references: [id])
  scrapeRunId   String
  scrapeRun     ScrapeRun @relation(fields: [scrapeRunId], references: [id])

  platform      String?
  title         String?
  text          String?
  url           String?
  author        String?
  authorUrl     String?
  publishedAt   DateTime?

  likes         Int?
  shares        Int?
  commentsCount Int?

  rawItem       String

  sentiment     String?
  confidence    Float?
  status        String   @default("RECEIVED")
  processingError String?
  analyzedAt    DateTime?
  alertSent     Boolean  @default(false)
  isCompetitor  Boolean  @default(false)

  // Which subsystem discovered this mention: "scraper" (Reddit/Quora/... Playwright
  // scrapers) or "google" (Google/Bing/YouTube SERP via Serper). Both land in this
  // table so totals are counted once, in one place.
  source        String   @default("scraper")

  // Relevance check ("is this text actually ABOUT the brand/competitor, or
  // generic same-topic chatter"), run in the same AI call as sentiment. null
  // = not evaluated (legacy row), treated as relevant for backward
  // compatibility. false = judged off-topic; excluded from alerts.
  relevant        Boolean?
  relevanceReason String?

  deletedAt     DateTime?
  purgeAt       DateTime?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  comments      Comment[]

  @@index([keywordId])
  @@index([sentiment])
  @@index([status])
  @@index([publishedAt])
  @@index([isCompetitor])
  @@index([source])
  @@index([relevant])
  @@index([deletedAt])
}

model Comment {
  id            String   @id @default(cuid())
  sourceKey     String   @unique

  keywordId     String
  keyword       Keyword  @relation(fields: [keywordId], references: [id])
  scrapeRunId   String
  scrapeRun     ScrapeRun @relation(fields: [scrapeRunId], references: [id])

  postId        String?
  post          Post?    @relation(fields: [postId], references: [id])

  // Reply threading. Top-level comments have parentCommentId = null and depth 0;
  // a reply to a reply is depth 2, and so on.
  parentCommentId String?
  parentComment Comment?  @relation("CommentReplies", fields: [parentCommentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replies       Comment[] @relation("CommentReplies")
  depth         Int      @default(0)

  text          String?
  url           String?
  author        String?
  authorUrl     String?
  publishedAt   DateTime?

  likes         Int?

  rawItem       String

  sentiment     String?
  confidence    Float?
  status        String   @default("RECEIVED")
  processingError String?
  analyzedAt    DateTime?
  alertSent     Boolean  @default(false)
  isCompetitor  Boolean  @default(false)

  relevant        Boolean?
  relevanceReason String?

  deletedAt     DateTime?
  purgeAt       DateTime?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([keywordId])
  @@index([postId])
  @@index([parentCommentId])
  @@index([sentiment])
  @@index([status])
  @@index([publishedAt])
  @@index([isCompetitor])
  @@index([relevant])
  @@index([deletedAt])
}

// Persistent key-value settings stored directly in database for production deployment (Railway/Neon)
model SystemSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// Audit trail for every soft-delete/restore/purge. No auth/session system
// exists in this app, so `actor` is a best-effort free-text field rather
// than a real user id. `label` is a snapshot captured at delete time so the
// log stays meaningful after the underlying row is purged.
model DeletionLog {
  id         String    @id @default(cuid())
  entityType String    // "Keyword" | "PlatformKeyword" | "CompetitorCard" | "Post" | "Comment"
  entityId   String
  label      String
  actor      String?
  deletedAt  DateTime  @default(now())
  restoredAt DateTime?
  purgedAt   DateTime?

  @@index([entityType, entityId])
  @@index([purgedAt])
}
